[Service]
ExecStart=
ExecStart=/usr/local/bin/laravel-waf-agent --socket /run/laravel-waf/agent.sock --socket-group www-data --secret-file /etc/laravel-waf/agent.secret --gate-socket /run/laravel-waf/gate.sock --gate-socket-group www-data --gate-threshold 600 --gate-window 60s --challenge-cookie laravel_waf_challenge --challenge-secret-file /etc/laravel-waf/challenge.secret --gate-token-file /etc/laravel-waf/gate-token.secret
