{
    "name": "billingserv/laravel-waf",
    "description": "Configurable application-layer WAF protection for Laravel applications.",
    "keywords": [
        "laravel",
        "waf",
        "ddos",
        "xss",
        "sql-injection",
        "geoip",
        "captcha",
        "login-protection",
        "security",
        "rate-limit",
        "bot-protection",
        "nginx",
        "prometheus"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "BillingServ",
            "homepage": "https://github.com/BillingServ"
        }
    ],
    "require": {
        "php": "^8.2",
        "altcha-org/altcha": "^1.1.2|^2.0",
        "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/config": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "psr/log": "^3.0"
    },
    "suggest": {
        "promphp/prometheus_client_php": "Enable the optional Prometheus metrics endpoint.",
        "predis/predis": "Use Redis-backed Prometheus aggregation without the phpredis extension.",
        "geoip2/geoip2": "Enable the built-in MaxMind GeoIP2/GeoLite2 database resolver.",
        "illuminate/mail": "Enable the built-in email notification channel."
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.1|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "BillingServ\\LaravelWaf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BillingServ\\LaravelWaf\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BillingServ\\LaravelWaf\\WafServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "find src tests config routes -name '*.php' -print0 | xargs -0 -n1 php -l",
        "go-check": [
            "cd agent && test -z \"$(gofmt -l .)\"",
            "cd agent && go vet ./...",
            "cd agent && go test ./..."
        ],
        "check": [
            "@lint",
            "@test",
            "@go-check"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
