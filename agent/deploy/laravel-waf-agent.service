[Unit]
Description=Laravel WAF ipset decision agent
After=network-online.target firewall.service
Wants=network-online.target firewall.service
PartOf=firewall.service

[Service]
Type=simple
ExecStart=/usr/local/bin/laravel-waf-agent --socket /run/laravel-waf/agent.sock --socket-group www-data --secret-file /etc/laravel-waf/agent.secret --block-tcp-ports 80,443
Restart=on-failure
RestartSec=5s
User=root
Group=root
RuntimeDirectory=laravel-waf
RuntimeDirectoryMode=0750
StateDirectory=laravel-waf
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/laravel-waf
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
